From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Local Yocto migration <local@invalid>
Date: Wed, 19 Aug 2026 00:00:00 +0000
Subject: [PATCH] net-snmp: port snmpusm DH access to OpenSSL 1.1

OpenSSL 1.1 makes struct DH opaque. Access p, g and the public key
through DH_get0_pqg() and DH_get0_key() instead of dereferencing
DH fields directly.

Upstream-Status: Backport

--- a/apps/snmpusm.c
+++ b/apps/snmpusm.c
@@ -190,3 +190,4 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
     u_char *dhkeychange;
     DH *dh;
+    const BIGNUM *p, *g, *pub_key;
     BIGNUM *other_pub;
@@ -205 +206,4 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
-    if (!dh || !dh->g || !dh->p) {
+    if (dh)
+        DH_get0_pqg(dh, &p, NULL, &g);
+
+    if (!dh || !g || !p) {
@@ -210,2 +214 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
-    DH_generate_key(dh);
-    if (!dh->pub_key) {
+    if (!DH_generate_key(dh)) {
@@ -216 +219,3 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
-    if (vars->val_len != (unsigned int)BN_num_bytes(dh->pub_key)) {
+    DH_get0_key(dh, &pub_key, NULL);
+
+    if (vars->val_len != (unsigned int)BN_num_bytes(pub_key)) {
@@ -219 +224 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
-                (unsigned long)vars->val_len, BN_num_bytes(dh->pub_key));
+                (unsigned long)vars->val_len, BN_num_bytes(pub_key));
@@ -223 +228 @@ get_USM_DH_key(netsnmp_variable_list *vars, netsnmp_variable_list *dhvar,
-    BN_bn2bin(dh->pub_key, dhkeychange + vars->val_len);
+    BN_bn2bin(pub_key, dhkeychange + vars->val_len);
-- 
2.17.1
